# WhyTrace — copy to .env. Never commit .env.

# Keep 1 until Zetaris ping succeeds
USE_MOCK=1

# --- Zetaris (preferred: UI proxy, same as zetaris/getting-started) ---
# https://github.com/zetaris/getting-started
ZETARIS_CHANNEL=proxy
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
# Optional fallback if no API key yet:
# ZETARIS_USERNAME=
# ZETARIS_PASSWORD=
ZETARIS_QUERY_LIMIT=50
# ZETARIS_ENGINE_ID=

# Direct REST only if proxy unavailable (older OpenSqlQuery style)
# ZETARIS_CHANNEL=direct
# ZETARIS_REST_URL=http://localhost:8888/api/v1.0

# --- Meterless ---
METERLESS_BRIDGE=mock
METERLESS_STORE_DIR=.whytrace/memory
# Optional Runtime for synthesis:
# METERLESS_RUNTIME_URL=http://127.0.0.1:8088/v1
# METERLESS_RUNTIME_TOKEN=
# METERLESS_APP_ID=whytrace

# --- Synthesis ---
# mock | meterless | openai | nemotron
SYNTHESIS_PROVIDER=mock
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# NEMOTRON_API_KEY=
# NEMOTRON_BASE_URL=
# SYNTHESIS_MODEL=gpt-4o-mini
